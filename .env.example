# Public origin, used to build claim links.
http://localhost:2345

# Two planes on one listener.
CONTROL_HOST=localhost:2345
PUBLIC_URL=http://localhost:2345
# Previews live at <slug><suffix>. *.localhost resolves to loopback,
# so this works locally; production needs real wildcard DNS + TLS.
DATA_HOST_SUFFIX=.preview.localhost
DATA_SCHEME=http
